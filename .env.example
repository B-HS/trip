DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=
SEED_OWNER_EMAIL=

# 선택 — OAuth. ID와 secret을 모두 채운 provider만 로그인 화면에 표시된다
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택 — Cloudflare Email Worker. 세 값을 모두 채우면 이메일 인증이 활성화된다
EMAIL_WORKER_URL=
EMAIL_WORKER_TOKEN=
EMAIL_FROM=

# 선택 — AI 사용자 키 암호화·Vercel Queues. 값은 문서의 발급 절차를 따르고 저장하지 않는다
APP_ENCRYPTION_KEY=
VERCEL_QUEUE_REGION=
VERCEL_QUEUE_TOKEN=
VERCEL_QUEUE_URL=
CRON_SECRET=
# 테스트 전용 — provider 호출을 하지 않는 결정적 mock 응답
AI_PROVIDER_MOCK=
